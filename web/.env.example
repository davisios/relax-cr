# Google Analytics 4 — measurement ID from GA4 Admin > Data Streams (format: G-XXXXXXXXXX).
# The GA4 script only loads when this is set.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console — content value of the HTML-tag verification method.
# Only needed if the domain is not already verified by DNS.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
